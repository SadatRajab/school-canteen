# ========================================
# School Canteen Backend - Environment Variables
# ========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/school-canteen
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/school-canteen

# Admin Credentials (SINGLE ACCOUNT ONLY)
ADMIN_EMAIL=admin@schoolcanteen.com
# Generate hash using: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(hash => console.log(hash));"
ADMIN_PASSWORD_HASH=$2a$10$exampleHashGoesHere

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=12h

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
# For production: https://yourdomain.com
# For multiple origins: http://localhost:4200,https://yourdomain.com
